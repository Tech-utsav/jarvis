# Copy to .env and fill in. NEVER commit .env
PORT=3000
# Optional: shared password so strangers can't use your AI quota. Leave empty for local testing.
APP_TOKEN=
# AI provider: "openai" (any OpenAI-compatible API: Groq, OpenRouter, Gemini) or "anthropic"
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
# Optional web search (Tavily has a free tier). Leave empty to disable.
TAVILY_API_KEY=
